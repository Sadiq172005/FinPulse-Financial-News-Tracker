# Copy this file to .env and fill in your key. Never commit .env.

# Set ONE of the two keys below (server-side only).
# If both are set, Claude is used unless AI_PROVIDER says otherwise.

# Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional: force a provider, "anthropic" or "openai"
AI_PROVIDER=

# Port for the Express API
PORT=8787

# Optional: comma-separated list of origins allowed to call the API
# (leave empty to allow all origins during local development)
ALLOWED_ORIGINS=

# Optional, front end only: URL of a deployed API, e.g. https://finpulse-api.onrender.com
# Leave empty when the API is served from the same origin or through the Vite proxy.
VITE_API_BASE=
